{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "cache": true,
      "env": ["NODE_ENV"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "cache": true,
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true
    },
    "type-check": {
      "dependsOn": ["^build", "build"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "sdk:generate": {
      "cache": false,
      "outputs": ["src/sdk/**", "openapi.json"]
    },
    "format": {
      "cache": false
    },
    "clean": {
      "dependsOn": ["^clean"],
      "cache": false
    }
  },
  "globalDependencies": [
    ".env",
    ".env.local",
    ".env.production",
    ".env.*.local",
    "tsconfig.json",
    "eslint.config.mjs",
    ".prettierrc"
  ]
}
